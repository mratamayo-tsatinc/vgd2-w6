# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.
#
# This file is only needed if you use the Supabase CLI for local dev/testing
# (§11.7 "CLI path" in the project brief). The static site itself reads its
# Project URL / anon key directly from js/supabaseClient.js, not from env vars,
# since GitHub Pages serves plain static files with no build-time env injection
# unless you add a bundler step later.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Secret — only ever used for local CLI/manual testing, never shipped anywhere.
# Edge Functions get this automatically at runtime; you should rarely need to
# paste it here yourself.
SUPABASE_SERVICE_ROLE_KEY=
